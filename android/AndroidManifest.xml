<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.mpreader.reader"
    android:versionCode="1"
    android:versionName="1.0.0">
    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="35" />
    <application android:allowBackup="false" android:label="mp-reader"
        android:icon="@drawable/ic_reader" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".ReaderActivity" android:exported="true" android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/epub+zip" />
            </intent-filter>
        </activity>
    </application>
</manifest>
